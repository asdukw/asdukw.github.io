# Supabase Postgres connection string from Project Settings > Database > Connect.
# Use the session-mode/direct connection (usually port 5432) for a long-running
# FastAPI service. Use the transaction pooler (port 6543) with NullPool when the
# deployment platform creates short-lived or many concurrent processes.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<host>:5432/postgres?ssl=require

# Public website and GitHub OAuth App configuration.
SITE_URL=https://asdukw.pages.dev
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://api.example.com/api/auth/callback

# Comma-separated browser origins. Do not use * with credentials enabled.
CORS_ORIGINS=https://asdukw.pages.dev,http://localhost:3000

# In production, cross-origin cookies require Secure + SameSite=None.
SESSION_COOKIE_NAME=site_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none
SESSION_COOKIE_DOMAIN=
SESSION_TTL_DAYS=30

# GitHub numeric user id. The backend uses this for real admin authorization.
ADMIN_GITHUB_ID=12345678

# Optional one-off import token for comments from the former GitHub service.
# Keep it only in a local/secret environment and remove it after importing.
GITHUB_MIGRATION_TOKEN=
