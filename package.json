{
  "name": "asdukw-site",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "lint": "eslint .",
    "smoke": "bun scripts/ssr-smoke.tsx",
    "css": "bun x @tailwindcss/cli -i ./src/index.css -o ./src/styles.css --minify",
    "css:watch": "bun x @tailwindcss/cli -i ./src/index.css -o ./src/styles.css --watch",
    "build:content": "bun scripts/build-content.ts",
    "dev": "bun run build:content && bun run css && bun --hot src/index.ts",
    "build": "bun run build:content && bun run css && bun build ./src/index.html --outdir=dist --public-path=/ --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*' && bun scripts/copy-favicon.ts && bun scripts/copy-404.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "dev:api": "wrangler dev --config worker/wrangler.toml",
    "deploy:api": "wrangler deploy --config worker/wrangler.toml",
    "deploy:pages": "bun run build && bun x wrangler pages deploy dist --project-name asdukw --branch master"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "postcss": "^8.5.26",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@eslint/js": "^10.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "gray-matter": "^4.0.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "unist-util-visit": "^5.1.0",
    "wrangler": "^4.129.0"
  }
}
