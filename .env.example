# --- Server-side OAuth (Bun dev / Cloudflare Worker) ---
# GitHub OAuth App credentials: https://github.com/settings/developers
GH_CLIENT_ID=your_github_client_id
GH_CLIENT_SECRET=your_github_client_secret

# --- Local Cloudflare deployment (Wrangler) ---
# Create an API Token in Cloudflare Dashboard > My Profile > API Tokens.
# Keep the real token in .env only; never commit .env or put this value in wrangler.toml.
# The token needs Account: Cloudflare Pages:Edit and Workers Scripts:Edit.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# --- Client-side (inlined into the SPA bundle via BUN_PUBLIC_*) ---
# Base URL of the Cloudflare Worker that serves /api/auth/*.
# In local dev, leave empty to use the same-origin Bun server routes.
BUN_PUBLIC_AUTH_API_URL=

# Your GitHub numeric user ID (used for the admin check on the client side).
BUN_PUBLIC_ADMIN_USER_ID=12345678
