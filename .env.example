# --- Legacy GitHub OAuth (Bun dev / Cloudflare Worker rollback path) ---
# GitHub OAuth App credentials: https://github.com/settings/developers
GH_CLIENT_ID=your_github_client_id
GH_CLIENT_SECRET=your_github_client_secret
GH_REPO_OWNER=asdukw
GH_REPO_NAME=asdukw.github.io
GH_DISCUSSION_CATEGORY=general

# --- FastAPI + Supabase backend ---
# The FastAPI service reads the same root .env during local development.
# Use the SQLAlchemy asyncpg URL copied from Supabase Project Settings >
# Database > Connect. Never commit the real password.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<host>:5432/postgres?ssl=require
SITE_URL=http://localhost:3000
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/callback
CORS_ORIGINS=http://localhost:3000,https://asdukw.pages.dev
SESSION_COOKIE_NAME=site_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_TTL_DAYS=30
ADMIN_GITHUB_ID=12345678

# --- Local Cloudflare deployment (Wrangler) ---
# Create an API Token in Cloudflare Dashboard > My Profile > API Tokens.
# Keep the real token in .env only; never commit .env or put this value in wrangler.toml.
# The token needs Account: Cloudflare Pages:Edit and Workers Scripts:Edit.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# --- Client-side (inlined into the SPA bundle via BUN_PUBLIC_*) ---
# Base URL of the FastAPI service. Set this to the deployed HTTPS API URL for
# the production Pages build. The old variable remains as a rollback fallback.
BUN_PUBLIC_API_URL=http://localhost:8000
BUN_PUBLIC_AUTH_API_URL=

# Your GitHub numeric user ID (used for the admin check on the client side).
BUN_PUBLIC_ADMIN_USER_ID=12345678
